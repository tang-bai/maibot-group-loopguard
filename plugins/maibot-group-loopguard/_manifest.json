{
  "manifest_version": 2,
  "id": "maibot-community.group-loop-guard",
  "version": "1.0.1",
  "name": "群聊复读守卫",
  "description": "同群有多个 AI 机器人时，自动识别机器人身份、拦截复读与互相接话，按指数退避冷却避免无限对话",
  "author": {
    "name": "MaiBot 社区",
    "url": "https://github.com/Mai-with-u"
  },
  "license": "GPL-3.0-or-later",
  "urls": {
    "repository": "https://github.com/Mai-with-u/MaiBot",
    "homepage": "https://docs.maibot.chat/",
    "documentation": "https://docs.maibot.chat/plugin/",
    "issues": "https://github.com/Mai-with-u/MaiBot/issues"
  },
  "changelog": "CHANGELOG.md",
  "host_application": {
    "min_version": "1.3.0",
    "max_version": "1.3.99"
  },
  "sdk": {
    "min_version": "2.0.0",
    "max_version": "2.99.99"
  },
  "dependencies": [],
  "capabilities": [
    "config.get",
    "send.text",
    "frequency.set_adjust"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  },
  "plugin_type": "extension"
}
